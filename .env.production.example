# 数据库密码 (必须修改)
DB_PASSWORD=your_secure_db_password

# JWT 密钥 (必须修改，建议用 openssl rand -hex 32 生成)
JWT_SECRET=your_jwt_secret_here

# Token 加密密钥 (必须修改，用 openssl rand -hex 32 生成)
TOKEN_ENCRYPT_KEY=your_64_hex_char_key_here

# 前端端口
FRONTEND_PORT=80

# 支付配置
# PAYMENT_PROVIDER 可选：mock、xunhupay、payjs
# 生产收费必须使用 xunhupay/payjs 并填入商户参数；mock 仅用于内测/手动激活。
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=false
PAYMENT_APP_ID=
PAYMENT_APP_SECRET=
PAYMENT_NOTIFY_URL=https://yourdomain.com/api/payments/notify
PAYMENT_RETURN_URL=https://yourdomain.com/admin/subscription

# 代理 (前期测试阶段关闭)
PROXY_ENABLED=false
