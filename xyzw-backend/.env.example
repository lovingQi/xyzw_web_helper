# Database
DATABASE_URL=postgres://xyzw:your_password@localhost:5432/xyzw

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Token encryption
TOKEN_ENCRYPT_KEY=your_32_char_hex_key_change_this

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Payment (third-party aggregated payment)
PAYMENT_APP_ID=
PAYMENT_APP_SECRET=
PAYMENT_NOTIFY_URL=https://yourdomain.com/api/payments/notify

# Proxy (skip in testing phase)
PROXY_ENABLED=false
PROXY_API_URL=
PROXY_API_KEY=
